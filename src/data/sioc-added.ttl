# What the published file lacks: the suggested prefix of the ontology. Only metadata; never a new
# term (see README §The data).
@prefix vann: <http://purl.org/vocab/vann/> .

<http://rdfs.org/sioc/ns#>
    vann:preferredNamespacePrefix "sioc" ;
    vann:preferredNamespaceUri "http://rdfs.org/sioc/ns#" .
